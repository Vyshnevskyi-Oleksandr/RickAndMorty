{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "react",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "es2020"
  },
  "include": ["__tests__/**/*", "src/**/*", "__mocks__/**/*"]
}
